      "groupIds": [],
      "frameId": "auth-3",
      "roundness": null,
      "seed": 689532943,
      "version": 1,
      "versionNonce": 689532943,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "There is nothing to forget or reset. Every sign-in is the email link or code, Google, or Apple.\n\nForgot which one you used? Any of them with the same verified email opens the same account, with its Likes\n(AUTH-10).",
      "originalText": "There is nothing to forget or reset. Every sign-in is the email link or code, Google, or Apple.\n\nForgot which one you used? Any of them with the same verified email opens the same account, with its Likes\n(AUTH-10).",
