      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A confirmation is only for what can't be\nundone: deleting a list with titles (LIST-7)\nand ending a connection (CONN-3).\nEverything else gets a message with Undo.",
      "originalText": "A confirmation is only for what can't be\nundone: deleting a list with titles (LIST-7)\nand ending a connection (CONN-3).\nEverything else gets a message with Undo.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
