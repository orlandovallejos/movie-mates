      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "It names what will be lost, and only that. It\ndoesn't promise the titles stay in your\nLikes: a title can be in a list without being\nliked.",
      "originalText": "It names what will be lost, and only that. It\ndoesn't promise the titles stay in your\nLikes: a title can be in a list without being\nliked.",
