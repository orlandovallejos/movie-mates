      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Offline the app calls no server. Hearts and\nAdd to list stay visible but disabled\n(dashed), and tapping one repeats the\nbanner's words in a message. Nothing is\nkept to send later.",
      "originalText": "Offline the app calls no server. Hearts and\nAdd to list stay visible but disabled\n(dashed), and tapping one repeats the\nbanner's words in a message. Nothing is\nkept to send later.",
